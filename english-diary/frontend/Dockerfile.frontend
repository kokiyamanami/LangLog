# ============================================
# Nginx フロントエンドコンテナ
# ============================================
# 役割：React アプリ配信 + FastAPI へのプロキシ
# ポート：80

# ============================================
# ステージ 1: React ビルド
# ============================================
# 目的：npm dependencies を最小化し、dist/ を生成
FROM node:18-alpine AS frontend-builder

WORKDIR /frontend

# package.json / package-lock.json をコピー
COPY package*.json ./

# npm install でインストール
# package-lock.json がなくても実行可能
# 初回は npm install、以降は npm ci（キャッシュ活用）
RUN npm install

# React プロジェクト全体をコピー
COPY . ./

# React をビルド（dist/ に最適化版を生成）
RUN npm run build

# ============================================
# ステージ 2: Nginx 実行イメージ
# ============================================
# 目的：React dist を配信し、API をプロキシ
FROM nginx:1.24-alpine

# ビルド済みの React dist をコピー
# マルチステージビルドで前のステージの出力を利用
# これにより最終イメージには node_modules が含まれない
COPY --from=frontend-builder /frontend/dist /usr/share/nginx/html

# ============================================
# ポート公開
# ============================================
EXPOSE 80

# ============================================
# Nginx 起動
# ============================================
# daemon off：コンテナのメインプロセスとして動作
# （バックグラウンド化しない）
CMD ["nginx", "-g", "daemon off;"]
