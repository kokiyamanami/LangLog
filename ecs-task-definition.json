{
  "family": "langlog-api-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::389323710086:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "langlog-api",
      "image": "389323710086.dkr.ecr.ap-northeast-1.amazonaws.com/langlog-backend:latest",
      "essential": true,
      "environment": [
        {
          "name": "DATABASE_URL",
          "value": "postgresql://langlogadmin:LangLogPassword123!@langlog-db.cx0cgqgk4tr2.ap-northeast-1.rds.amazonaws.com:5432/langlog"
        },
        {
          "name": "ENVIRONMENT",
          "value": "production"
        }
      ],
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/langlog-api",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}